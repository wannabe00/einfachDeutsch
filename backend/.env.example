# Backend environment variables. Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Debug mode. Use True for local development, False in production.
DEBUG=True

# Gemini API key — powers the AI assistant chat. Get a free key at
# https://aistudio.google.com/apikey  Leave blank to keep AI disabled (graceful 503).
GEMINI_API_KEY=

# Azure Speech key + region (portal: Speech resource, Free F0 -> Keys and Endpoint).
# Hören recordings (make_hoeren_audio; blank = Gemini TTS) and the AI Assistant's
# read-aloud button (blank = 503). Set on Render too.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---- Production (leave blank for local dev) ----
# Comma-separated hosts Django will serve (e.g. your Render domain).
ALLOWED_HOSTS=
# Neon Postgres connection string. If unset, falls back to local SQLite.
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=
# SPA origin(s) allowed to call the API (e.g. https://yourapp.vercel.app).
CORS_ALLOWED_ORIGINS=
# Origins trusted for cross-site POSTs (same Vercel URL, scheme included).
CSRF_TRUSTED_ORIGINS=
# Public URL of the frontend — used to build the email verification link.
FRONTEND_URL=

# ---- OAuth (Google + GitHub) — account creation is social-login only ----
# Client IDs are public; secrets stay backend-only. Redirect/callback URLs must
# match FRONTEND_URL/auth/callback/<provider>. The frontend also needs the IDs
# (VITE_GOOGLE_CLIENT_ID / VITE_GITHUB_CLIENT_ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Email (SMTP) — optional now (no verification; only password reset) ----
# If EMAIL_HOST is set, Django uses real SMTP; otherwise mail prints to the console.
# Brevo example: EMAIL_HOST=smtp-relay.brevo.com, EMAIL_HOST_USER=<your @smtp-brevo.com
# login>, EMAIL_HOST_PASSWORD=<SMTP key>, DEFAULT_FROM_EMAIL="Name <verified@sender.com>".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional throttle overrides (defaults: anon 120/min, user 600/min, ai 12/min + 120/day).
THROTTLE_ANON=
THROTTLE_USER=
THROTTLE_AI_BURST=
THROTTLE_AI_DAILY=

# Daily streaks: a missed day uses a freeze token. Defaults shown.
STREAK_INITIAL_FREEZE_TOKENS=2
STREAK_FREEZE_EARN_DAYS=14
STREAK_FREEZE_MAX=5

# Talk to AI: live voice conversations per premium user per day.
TALK_DAILY_CAP=5
TALK_MONTHLY_CAP=5

# Video suggestions (Phase 17): minimum CEFR level at which they unlock.
VIDEO_UNLOCK_MIN_LEVEL=B1
# Most AI-written history lessons per user per day (premium).
HISTORY_AI_DAILY_LIMIT=5
# Optional: last-resort picture source for history lessons (free key from pexels.com/api)
PEXELS_API_KEY=

# Cloudinary (profile picture uploads). Leave blank to disable avatar uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Tunables (defaults shown; leave unset to use them) ----
TOKEN_TTL_DAYS=30
THROTTLE_LOGIN=5/min
THROTTLE_ONBOARDING=5/min
THROTTLE_PASSWORD_RESET=5/hour
ENERGY_MAX=3
ENERGY_REFILL_HOURS=4
PREMIUM_TRIAL_DAYS=7
EXAM_UNLOCK_RATIO=0.9
EXAM_PASS_THRESHOLD=0.8
EXAM_QUESTION_COUNT=12
EMAIL_TIMEOUT=10
# Production only (DEBUG=False): HTTPS redirect and HSTS lifetime in seconds.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ---- Cost guards (defaults shown) ----
# Site-wide daily caps: Gemini text calls, mic transcriptions, live talks, and
# read-aloud characters. Over a cap the feature answers 503 until tomorrow.
AI_CAP_TEXT=2000
AI_CAP_TRANSCRIBE=500
AI_CAP_TALK=60
AI_CAP_SPEECH_CHARS=15000
# Switch features off at once, comma-separated: text,transcribe,talk,speech
AI_DISABLED=
# Placement test submissions per user per day (each asks Gemini).
THROTTLE_PLACEMENT=5/day
# Largest request body accepted, in bytes (6 MB).
MAX_REQUEST_BYTES=6291456

# ---- Rate limits (defaults shown) ----
# Proxies in front of the backend that append to X-Forwarded-For (Render: 1,
# 0 locally). Wrong values let clients fake their IP or lump users together;
# check /api/accounts/client-ip/ (staff) after a hosting change.
NUM_PROXIES=1
# Password-checked actions (change password, 2FA, delete...) and avatar uploads.
THROTTLE_PASSWORD_CHANGE=5/hour
THROTTLE_UPLOADS=10/hour

# ---- Admin ----
# Secret admin path in production, e.g. manage-7f3k9q (default "admin").
ADMIN_URL=admin
# Staff need two-factor login on to use the admin (default: on unless DEBUG).
ADMIN_REQUIRE_2FA=

# ---- Monitoring ----
# sentry.io project DSN (Settings > Client Keys). Blank = error tracking off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
